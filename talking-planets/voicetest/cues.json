[[0.0, 1.8601666666666667, "EARTH", "Quick vote. Who's got the longest day?"], [1.9801666666666669, 4.6935416666666665, "JUPITER", "Me! Biggest planet, biggest day, obviously."], [4.8135416666666675, 7.049000000000001, "EARTH", "Bro, you spin in under ten hours."], [7.1690000000000005, 9.136041666666667, "JUPITER", "That's called speed, it's giving efficient."], [9.256041666666667, 10.83875, "EARTH", "Mine's about twenty-four hours."], [10.95875, 13.499041666666667, "MARS", "Mine's forty minutes longer. Your day is mid."], [13.619041666666668, 16.497541666666667, "MERCURY", "Fifty-nine days! I'm tiny but I'm SLOW!"], [16.617541666666668, 17.753, "EARTH", "Okay, Mercury ate."], [17.873, 19.984791666666666, "VENUS", "Cute, two hundred forty-three days."], [20.104791666666667, 20.601958333333332, "ALL", "WHAT?!"], [20.721958333333333, 24.574291666666667, "VENUS", "And my year is only two twenty-five. My day is longer than my year."], [24.694291666666665, 25.607625, "MERCURY", "That's illegal."], [25.727624999999996, 26.38133333333333, "JUPITER", "No cap?"], [26.501333333333328, 29.102624999999996, "VENUS", "No cap! Oh, and I spin backwards."], [29.222624999999994, 31.16366666666666, "VENUS", "Here, the Sun rises in the west."], [31.28366666666666, 33.407041666666665, "EARTH", "Okay, Venus is the main character."], [33.52704166666666, 34.595166666666664, "VENUS", "Always was."]]